generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Convenções: dinheiro em centavos (Int), peso em gramas (Int), datas em UTC.
// Saldo de estoque oficial = campo `estoque` (Produto/Insumo), alterado só por
// decremento/incremento atômico. MovimentacaoEstoque é apenas histórico.

// ───────────── Enums ─────────────

enum Papel {
  ADMIN // plataforma (Taaki Delivery): acima do DONO, sem loja
  DONO
  ATENDENTE
}

enum TipoPreco {
  UNIDADE
  POR_KG
}

enum CanalPedido {
  SITE
  WHATSAPP
  SALAO
  APP // app Taaki Delivery (antes ia como SITE): campanha, pino obrigatório em loja PLATAFORMA e pagamento online
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO // pago online: espera a aprovação; fora do PDV, da fila e do caixa
  ABERTO
  CONFIRMADO
  EM_PREPARO // delivery/encomenda: só uso interno do PDV (o cliente não vê)
  SAIU_ENTREGA
  FINALIZADO
  CANCELADO
  EXPIRADO // pagamento online não aprovado no prazo; fora do relatório de cancelados
}

enum FormaPagamento {
  PIX
  DINHEIRO
  DEBITO
  CREDITO
}

enum TipoMovimentacao {
  VENDA
  ESTORNO
  ENTRADA
  AJUSTE
}

enum TipoTrabalhoImpressao {
  PEDIDO
  CANCELAMENTO
  CONTA
  FECHAMENTO
  RELATORIO_DIA
}

enum TipoMovimentoCaixa {
  SANGRIA
  SUPRIMENTO
}

enum StatusTrabalhoImpressao {
  PENDENTE
  IMPRESSO
  FALHOU
}

// ───────────── Loja ─────────────

/// Loja da plataforma. A Cabana Boemia é a primeira (slug "cabana-boemia", criada pela
/// migration `multi_loja` a partir da antiga Configuracao). Leva a configuração que era
/// da linha única: nome, WhatsApp, tempo estimado, virada do dia e frete grátis.
/// CHECKs (só na migration): slug, documento (11 ou 14 dígitos), cores #RRGGBB,
/// horaViradaDia 0–12, frete grátis ligado exige mínimo > 0.
model Loja {
  id                        Int         @id @default(autoincrement())
  slug                      String      @unique @db.VarChar(60) // minúsculas, números e hífen
  nome                      String      @db.VarChar(100)
  razaoSocial               String?     @db.VarChar(150)
  documento                 String?     @db.VarChar(14) // CNPJ (14) ou CPF (11), só dígitos
  endereco                  String?     @db.VarChar(200)
  whatsapp                  String      @default("") // só dígitos com o 55 (wa.me); vazio = não configurado
  logoUrl                   String?     @db.VarChar(500)
  corPrimaria               String?     @db.VarChar(7) // "#RRGGBB"
  corFundo                  String?     @db.VarChar(7)
  corPrimariaPadrao         String?     @db.VarChar(7) // definida pelo ADMIN; "Voltar ao padrão" do dono
  logoUrlPadrao             String?     @db.VarChar(500)
  descricao                 String?     @db.VarChar(500)
  ativa                     Boolean     @default(true)
  ordem                     Int         @default(0)
  tempoEstimadoPadraoMin    Int         @default(40)
  tempoEstimadoManualMin    Int?
  tempoManualDefinidoEm     DateTime?
  horaViradaDia             Int         @default(4) // dia operacional vira às HH:00 local (0–12; CHECK)
  freteGratisAtivo          Boolean     @default(false)
  freteGratisMinimoCentavos Int? // frete grátis a partir deste subtotal (centavos); CHECK: ligado exige > 0
  freteGratisWhatsapp       Boolean     @default(true) // frete grátis vale também no delivery lançado pelo PDV
  /// Pino da loja (origem da distância até o cliente). Os dois ou nenhum (CHECK).
  latitude                  Float?
  longitude                 Float?
  /// Quem entrega: PROPRIO (motoboy da loja, taxa da área é da loja) ou PLATAFORMA
  /// (entregador do Taaki, taxa por km é da plataforma). Só o ADMIN altera.
  modoEntrega               ModoEntrega @default(PROPRIO)
  /// A loja aceita pagamento online no app (vale só com a flag global e a conexão CONECTADA).
  pagamentoOnlineAtivo      Boolean     @default(false)
  criadoEm                  DateTime    @default(now())
  atualizadoEm              DateTime    @updatedAt

  conexaoMercadoPago ConexaoMercadoPago?
  alertas            AlertaPlataforma[]
  lancamentos        LancamentoLoja[]
  fechamentos        FechamentoSemanal[]
  usuarios           Usuario[]
  categorias         Categoria[]
  produtos           Produto[]
  insumos            Insumo[]
  turnos             Turno[]
  areas              AreaEntrega[]
  pedidos            Pedido[]
  contadores         ContadorPedido[]
  caixas             Caixa[]
  impressoes         TrabalhoImpressao[]
  imagens            ImagemLoja[]
  anuncios           Anuncio[]
}

/// Imagem enviada pela retaguarda (logo da loja), servida em /api/publico/imagens/:id.
/// CHECK: PNG/JPEG/WebP e até 500 KB (migration identidade_loja).
model ImagemLoja {
  id       Int      @id @default(autoincrement())
  lojaId   Int
  mime     String   @db.VarChar(20)
  dados    Bytes
  criadoEm DateTime @default(now())

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Restrict)

  @@index([lojaId])
}

// ───────────── Acesso ─────────────

/// ADMIN não tem loja; DONO e ATENDENTE têm exatamente uma (CHECK na migration `multi_loja`).
model Usuario {
  id           Int      @id @default(autoincrement())
  lojaId       Int?
  nome         String
  email        String   @unique
  senhaHash    String
  papel        Papel
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  loja Loja? @relation(fields: [lojaId], references: [id], onDelete: Restrict)

  refreshTokens       RefreshToken[]
  pedidosCriados      Pedido[]
  movimentacoes       MovimentacaoEstoque[]
  caixasAbertos       Caixa[]               @relation("CaixaAbertoPor")
  caixasFechados      Caixa[]               @relation("CaixaFechadoPor")
  movimentosCaixa     MovimentoCaixa[]
  anuncios            Anuncio[]
  lancamentos         LancamentoLoja[]
  fechamentosQuitados FechamentoSemanal[]
  alertasResolvidos   AlertaPlataforma[]
  estornos            Estorno[]             @relation("EstornoUsuario")
  estornosResolvidos  Estorno[]             @relation("EstornoResolvidoPor")

  @@index([lojaId])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  hash       String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// ───────────── Clientes ─────────────

model Cliente {
  id                   Int       @id @default(autoincrement())
  googleId             String?   @unique
  appleId              String?   @unique // "sub" do Entrar com Apple (app iOS)
  nome                 String
  /// Nome sem acento e minúsculo (busca do PDV: "joao" acha "João"). Calculado
  /// pela extensão em src/lib/prisma.js a cada gravação de `nome`; sem default.
  nomeBusca            String
  email                String?
  telefone             String?
  /// Telefone confirmado por código (login com celular). Mudar o telefone desfaz.
  /// Único entre os verificados: índice parcial "Cliente_telefone_verificado_key"
  /// (só na migration telefone_verificado; o Prisma não declara índice parcial).
  telefoneVerificado   Boolean   @default(false)
  telefoneVerificadoEm DateTime?
  observacao           String?   @db.VarChar(300) // anotação da equipe (PDV)
  /// Versão dos termos/política do app aceita por último (null = nunca aceitou; o site não usa).
  termosVersao         String?   @db.VarChar(20)
  termosAceitosEm      DateTime?
  /// Consentimento de marketing (opcional, revogável no Perfil do app; nasce desligado).
  marketing            Boolean   @default(false)
  marketingEm          DateTime?
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt

  enderecos      Endereco[]
  pedidos        Pedido[]
  refreshTokens  RefreshTokenCliente[]
  consentimentos Consentimento[]
  usosCampanha   UsoCampanhaFreteGratis[]

  @@index([telefone])
}

model Endereco {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  rua         String
  numero      String
  complemento String?
  referencia  String?
  bairroId    Int
  cep         String?  @db.VarChar(8) // só dígitos (PDV; o site não usa)
  cidade      String?  @db.VarChar(60)
  estado      String?  @db.VarChar(30)
  principal   Boolean  @default(false) // no máximo um por cliente (garantido no service)
  /// Pino confirmado no mapa (posição exata). Os dois ou nenhum (CHECK); o texto continua obrigatório.
  latitude    Float?
  longitude   Float?
  criadoEm    DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  bairro  Bairro  @relation(fields: [bairroId], references: [id])

  @@index([clienteId])
}

/// Bairro da cidade (lista única, cadastrada pelo ADMIN). O endereço do cliente
/// aponta para ele e vale para qualquer loja; onde cada loja entrega (e por quanto)
/// fica em AreaEntrega. Desativado na cidade = nenhuma loja entrega lá.
model Bairro {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  ativo Boolean @default(true)

  enderecos Endereco[]
  areas     AreaEntrega[]
}

/// Área de entrega da loja: bairros onde ela entrega, com a taxa dela.
/// Sem linha (ou inativa) = a loja não entrega no bairro (BAIRRO_FORA_DA_AREA).
/// CHECK (migration bairros_da_cidade): taxaCentavos >= 0.
model AreaEntrega {
  lojaId       Int
  bairroId     Int
  taxaCentavos Int
  ativo        Boolean @default(true)

  loja   Loja   @relation(fields: [lojaId], references: [id])
  bairro Bairro @relation(fields: [bairroId], references: [id])

  @@id([lojaId, bairroId])
  @@index([bairroId])
}

// ───────────── Cardápio ─────────────

model Categoria {
  id     Int     @id @default(autoincrement())
  lojaId Int
  nome   String
  ordem  Int     @default(0)
  ativo  Boolean @default(true)

  loja     Loja      @relation(fields: [lojaId], references: [id])
  produtos Produto[]

  @@unique([lojaId, nome])
}

/// Turnos, insumos e categoria do produto são da mesma loja (conferido no service).
model Produto {
  id              Int       @id @default(autoincrement())
  lojaId          Int
  nome            String
  descricao       String    @default("")
  categoriaId     Int
  tipoPreco       TipoPreco @default(UNIDADE)
  precoCentavos   Int // UNIDADE: preço da unidade; POR_KG: preço do quilo
  ativo           Boolean   @default(true)
  disponivelHoje  Boolean   @default(false)
  vendidoNoSite   Boolean   @default(true) // false: só aparece no PDV (ex.: Prato por kg)
  sugerirNaSacola Boolean   @default(false) // "Peça também" na sacola do site
  imagemUrl       String?   @db.VarChar(500) // link da foto (site); null = placeholder
  controlaEstoque Boolean   @default(false)
  estoque         Int? // saldo oficial quando controlaEstoque = true
  estoqueMinimo   Int?
  ordem           Int       @default(0)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  loja          Loja                  @relation(fields: [lojaId], references: [id])
  categoria     Categoria             @relation(fields: [categoriaId], references: [id])
  turnos        ProdutoTurno[]
  insumos       ProdutoInsumo[]
  itensPedido   ItemPedido[]
  movimentacoes MovimentacaoEstoque[]

  @@unique([lojaId, nome])
  @@index([categoriaId])
}

/// Horários (HorarioTurno) e produtos (ProdutoTurno) herdam a loja do turno.
model Turno {
  id     Int     @id @default(autoincrement())
  lojaId Int
  nome   String
  ativo  Boolean @default(true)

  loja     Loja           @relation(fields: [lojaId], references: [id])
  horarios HorarioTurno[]
  produtos ProdutoTurno[]

  @@unique([lojaId, nome])
}

model HorarioTurno {
  id        Int    @id @default(autoincrement())
  turnoId   Int
  diaSemana Int // 0 = domingo … 6 = sábado (validado no service)
  inicio    String @db.VarChar(5) // "HH:MM"
  fim       String @db.VarChar(5) // "HH:MM"; "00:00" = meia-noite (fim do dia)

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@index([turnoId, diaSemana])
}

model ProdutoTurno {
  produtoId Int
  turnoId   Int

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  turno   Turno   @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@id([produtoId, turnoId])
  @@index([turnoId])
}

// ───────────── Estoque ─────────────

model Insumo {
  id            Int    @id @default(autoincrement())
  lojaId        Int
  nome          String
  estoque       Int    @default(0) // saldo oficial
  estoqueMinimo Int    @default(0)

  loja          Loja                  @relation(fields: [lojaId], references: [id])
  produtos      ProdutoInsumo[]
  movimentacoes MovimentacaoEstoque[]

  @@unique([lojaId, nome])
}

model ProdutoInsumo {
  produtoId  Int
  insumoId   Int
  quantidade Int // unidades do insumo consumidas por 1 unidade do produto

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumo  Insumo  @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@id([produtoId, insumoId])
  @@index([insumoId])
}

/// Histórico/auditoria apenas. Nunca usado para calcular saldo.
model MovimentacaoEstoque {
  id           Int              @id @default(autoincrement())
  tipo         TipoMovimentacao
  produtoId    Int?
  insumoId     Int?
  quantidade   Int // delta com sinal: VENDA negativo, ESTORNO/ENTRADA positivo, AJUSTE ±
  itemPedidoId Int?
  usuarioId    Int?
  motivo       String?          @db.VarChar(200) // ENTRADA/AJUSTE da retaguarda (obrigatório no AJUSTE)
  criadoEm     DateTime         @default(now())

  produto    Produto?    @relation(fields: [produtoId], references: [id])
  insumo     Insumo?     @relation(fields: [insumoId], references: [id])
  itemPedido ItemPedido? @relation(fields: [itemPedidoId], references: [id])
  usuario    Usuario?    @relation(fields: [usuarioId], references: [id])

  @@index([produtoId])
  @@index([insumoId])
  @@index([itemPedidoId])
}

// ───────────── Pedidos ─────────────

/// Sempre de uma loja só (itens, caixa e impressões são da mesma loja).
model Pedido {
  id                             Int                    @id @default(autoincrement())
  lojaId                         Int
  /// Nulo só no AGUARDANDO_PAGAMENTO e no EXPIRADO (CHECK): número e dia são os da aprovação.
  numeroDia                      Int?
  dataRef                        DateTime               @db.Date // dia local (America/Sao_Paulo) do pedido
  canal                          CanalPedido
  status                         StatusPedido           @default(ABERTO)
  clienteId                      Int?
  nomeCliente                    String
  telefone                       String?
  enderecoTexto                  String?
  bairroNome                     String?
  taxaEntregaCentavos            Int                    @default(0)
  subtotalCentavos               Int                    @default(0)
  totalCentavos                  Int                    @default(0)
  formaPagamento                 FormaPagamento?
  trocoParaCentavos              Int?
  mesaRotulo                     String?
  tempoEstimadoMin               Int? // tempo mostrado ao cliente, gravado na criação
  chaveIdempotencia              String?                @unique // reenvio do mesmo pedido devolve o já criado
  criadoPorId                    Int?
  criadoEm                       DateTime               @default(now())
  atualizadoEm                   DateTime               @updatedAt
  finalizadoEm                   DateTime?
  canceladoEm                    DateTime?
  caixaId                        Int? // caixa em que foi FINALIZADO (ou pago antes, no "pago agora")
  /// Encomenda: entrega/retirada agendada (mesmo dia operacional). CHECK: encomenda = (agendadoPara não nulo).
  encomenda                      Boolean                @default(false)
  agendadoPara                   DateTime?
  retirarNoBalcao                Boolean                @default(false) // só encomenda, sem endereço nem taxa (CHECK)
  descontoCentavos               Int                    @default(0) // só pedidos da equipe; total = subtotal + taxa − desconto
  observacao                     String?                @db.VarChar(200) // observação do pedido inteiro
  pagoEm                         DateTime? // "pago agora" no PDV: forma e caixaId gravados na criação
  /// Chave de acesso da NFC-e emitida para a venda (prova de emissão), preenchida pela
  /// equipe. 44 dígitos, modelo 65 e dígito verificador conferidos no service; CHECK só dígitos.
  chaveNfce                      String?                @unique @db.VarChar(44)
  /// Posições usadas na distância (fotos do momento da compra) e a distância até o
  /// cliente pelas ruas (ROTA) ou linha reta × 1,3 (ESTIMADA). CHECKs: pares completos.
  latitudeEntrega                Float?
  longitudeEntrega               Float?
  latitudeLoja                   Float?
  longitudeLoja                  Float?
  distanciaMetros                Int?
  distanciaOrigem                OrigemDistancia?
  /// Frete grátis aplicado: da loja (custo da loja) ou da campanha da primeira compra (custo da plataforma).
  origemFreteGratis              OrigemFreteGratis      @default(NENHUM)
  /// Só com entregador da plataforma (CHECK: os três juntos): de onde veio a taxa (KM, ou AREA
  /// como reserva no PDV) e a divisão da taxa cheia (95% do entregador, meio para cima; o resto
  /// da plataforma), gravada mesmo com frete grátis.
  origemTaxaEntrega              OrigemTaxaEntrega?
  valorEntregadorCentavos        Int?
  valorPlataformaEntregaCentavos Int?
  /// Pago online (gravado na criação; nulo = pago na entrega). Nunca muda.
  meioOnline                     MetodoPagamentoOnline?
  /// Cartão pelo app: o tipo real que o Mercado Pago informou na aprovação (CHECK: só no CARTAO_ONLINE).
  tipoPagamentoOnline            TipoPagamentoOnline?
  /// Aceite da loja (só pedido pago online; CHECK). Depois dele, só o ADMIN cancela.
  aceitoEm                       DateTime?
  /// Taxa de entrega antes do frete grátis (só com entrega; gravada na criação). Base do
  /// crédito da campanha no livro-razão (loja com motoboy próprio).
  taxaEntregaCheiaCentavos       Int?

  loja        Loja                    @relation(fields: [lojaId], references: [id])
  cliente     Cliente?                @relation(fields: [clienteId], references: [id])
  caixa       Caixa?                  @relation(fields: [caixaId], references: [id], onDelete: Restrict)
  criadoPor   Usuario?                @relation(fields: [criadoPorId], references: [id])
  itens       ItemPedido[]
  impressoes  TrabalhoImpressao[]
  pagamentos  Pagamento[]
  lancamentos LancamentoLoja[]
  usoCampanha UsoCampanhaFreteGratis?
  alertas     AlertaPlataforma[]

  @@unique([lojaId, dataRef, numeroDia])
  @@index([status])
  @@index([clienteId, criadoEm])
  @@index([criadoEm])
  @@index([caixaId])
}

model ItemPedido {
  id                    Int       @id @default(autoincrement())
  pedidoId              Int
  produtoId             Int
  nomeSnapshot          String
  precoUnitarioCentavos Int // UNIDADE: por unidade; POR_KG: por quilo
  quantidade            Int       @default(1)
  pesoGramas            Int? // só para POR_KG
  totalCentavos         Int
  observacao            String?
  criadoEm              DateTime  @default(now())
  canceladoEm           DateTime?

  pedido        Pedido                @relation(fields: [pedidoId], references: [id])
  produto       Produto               @relation(fields: [produtoId], references: [id])
  movimentacoes MovimentacaoEstoque[]

  @@index([pedidoId])
  @@index([produtoId])
}

/// Último numeroDia emitido em cada dia operacional, por loja. Incrementado por
/// INSERT ... ON CONFLICT DO UPDATE dentro da transação do pedido (sem corrida).
model ContadorPedido {
  lojaId  Int
  dataRef DateTime @db.Date
  ultimo  Int

  loja Loja @relation(fields: [lojaId], references: [id])

  @@id([lojaId, dataRef])
}

// ───────────── Impressão ─────────────

/// Dono: um pedido (PEDIDO, CANCELAMENTO, CONTA), um caixa (FECHAMENTO) ou um dia operacional
/// (RELATORIO_DIA, `dataRelatorio`); exatamente um (CHECK).
model TrabalhoImpressao {
  id            Int                     @id @default(autoincrement())
  lojaId        Int
  pedidoId      Int?
  caixaId       Int?
  dataRelatorio DateTime?               @db.Date // RELATORIO_DIA: dia operacional do resumo
  tipo          TipoTrabalhoImpressao
  status        StatusTrabalhoImpressao @default(PENDENTE)
  tentativas    Int                     @default(0)
  ultimoErro    String?
  criadoEm      DateTime                @default(now())
  impressoEm    DateTime?
  /// Reserva do agente de impressão (POST /equipe/impressoes/reservar): dois agentes da
  /// mesma loja nunca imprimem o mesmo cupom. Vencida (reservadoAte < agora) = livre de novo.
  reservadoPor  String?                 @db.VarChar(64)
  reservadoAte  DateTime?

  loja   Loja    @relation(fields: [lojaId], references: [id])
  pedido Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  caixa  Caixa?  @relation(fields: [caixaId], references: [id], onDelete: Restrict)

  @@index([lojaId, status, criadoEm])
  @@index([pedidoId])
  @@index([caixaId])
}

// ───────── Caixa ─────────

/// Caixa do balcão (dinheiro de salão, delivery e site). Só um aberto por LOJA:
/// índice único parcial "Caixa_um_aberto" ("lojaId" WHERE "fechadoEm" IS NULL), só nas
/// migrations `caixa`/`multi_loja` (o Prisma não declara índice parcial). Esperado e diferença
/// são calculados e gravados no fechamento (cego para a equipe; só o DONO vê).
model Caixa {
  id                   Int       @id @default(autoincrement())
  lojaId               Int
  abertoPorId          Int
  abertoEm             DateTime  @default(now())
  valorInicialCentavos Int // fundo de troco
  fechadoPorId         Int?
  fechadoEm            DateTime?
  valorContadoCentavos Int?
  esperadoCentavos     Int?
  diferencaCentavos    Int? // contado − esperado
  observacao           String?

  loja       Loja                @relation(fields: [lojaId], references: [id])
  abertoPor  Usuario             @relation("CaixaAbertoPor", fields: [abertoPorId], references: [id])
  fechadoPor Usuario?            @relation("CaixaFechadoPor", fields: [fechadoPorId], references: [id], onDelete: Restrict)
  movimentos MovimentoCaixa[]
  pedidos    Pedido[]
  impressoes TrabalhoImpressao[]

  @@index([lojaId, abertoEm])
}

model MovimentoCaixa {
  id            Int                @id @default(autoincrement())
  caixaId       Int
  tipo          TipoMovimentoCaixa
  valorCentavos Int // > 0 (CHECK); o sinal vem do tipo
  motivo        String
  usuarioId     Int
  criadoEm      DateTime           @default(now())

  caixa   Caixa   @relation(fields: [caixaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([caixaId])
}

// ───────────── Sessão do app do cliente e exclusão de conta ─────────────

/// Refresh token do cliente (app). Opaco, rotativo, ~60 dias; no banco só o HMAC.
/// O site não pede refresh: continua só com o JWT de 7 dias.
model RefreshTokenCliente {
  id         Int       @id @default(autoincrement())
  clienteId  Int
  hash       String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

/// Pedido de exclusão de conta pela página pública /excluir-conta (link do Play Console).
/// Atendido à mão pelo dono (confere a identidade e exclui).
model SolicitacaoExclusao {
  id         Int       @id @default(autoincrement())
  nome       String?   @db.VarChar(100)
  email      String?   @db.VarChar(200)
  telefone   String?   @db.VarChar(20)
  mensagem   String?   @db.VarChar(500)
  criadoEm   DateTime  @default(now())
  atendidaEm DateTime?

  @@index([criadoEm])
}

enum EventoAcesso {
  LOGIN
  REFRESH
  PEDIDO
  EXCLUSAO_CONTA
}

/// Registro de acesso do cliente (Marco Civil da Internet, art. 15): guardado por
/// 6 meses e apagado por rotina diária. `clienteId` SEM chave estrangeira de
/// propósito: o registro precisa sobreviver à exclusão da conta pelo prazo legal.
model RegistroAcesso {
  id        Int          @id @default(autoincrement())
  clienteId Int?
  ip        String       @db.VarChar(45)
  evento    EventoAcesso
  criadoEm  DateTime     @default(now())

  @@index([criadoEm])
  @@index([clienteId])
}

// ───────── Consentimentos do cliente (app) ─────────

enum TipoConsentimento {
  TERMOS // aceitou os termos de uso e a política de privacidade da versão `versao`
  MARKETING_CONCEDIDO
  MARKETING_REVOGADO
}

/// Histórico (prova do consentimento, LGPD art. 8º §2º). O estado atual fica no Cliente.
model Consentimento {
  id        Int               @id @default(autoincrement())
  clienteId Int
  tipo      TipoConsentimento
  versao    String?           @db.VarChar(20) // versão dos documentos (TERMOS)
  ip        String            @db.VarChar(45)
  criadoEm  DateTime          @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, criadoEm])
}

// ───────── Anúncios (carrossel "Patrocinado" do app) ─────────

enum DestinoAnuncio {
  LOJA // abre a página de uma loja do app
  LINK // abre um link https
}

/// Imagem do anúncio (PNG/JPEG/WebP até 500 KB, CHECK), servida com cache longo: cada envio é outro id.
model ImagemAnuncio {
  id       Int      @id @default(autoincrement())
  mime     String   @db.VarChar(20)
  dados    Bytes
  criadoEm DateTime @default(now())

  anuncios Anuncio[]
}

/// Anúncio cadastrado pelo ADMIN. Sem exclusão pela API; um trigger impede
/// apagar antes de 1 ano depois do `fim` (registro da veiculação).
model Anuncio {
  id                   Int            @id @default(autoincrement())
  anuncianteNome       String         @db.VarChar(150)
  anuncianteDocumento  String         @db.VarChar(14) // CPF (11) ou CNPJ (14), só dígitos (CHECK)
  imagemId             Int
  destino              DestinoAnuncio
  destinoLojaId        Int? // destino LOJA (CHECK: um dos dois, conforme o destino)
  destinoUrl           String?        @db.VarChar(500) // destino LINK, https
  inicio               DateTime
  fim                  DateTime // CHECK fim > inicio
  valorPagoCentavos    Int // CHECK >= 0
  ativo                Boolean        @default(true)
  ordem                Int            @default(0)
  /// Declaração do ADMIN de que a peça não é dirigida a crianças (CHECK = true).
  naoDirigidoACriancas Boolean
  criadoPorId          Int
  criadoEm             DateTime       @default(now())
  atualizadoEm         DateTime       @updatedAt

  imagem      ImagemAnuncio @relation(fields: [imagemId], references: [id], onDelete: Restrict)
  destinoLoja Loja?         @relation(fields: [destinoLojaId], references: [id], onDelete: Restrict)
  criadoPor   Usuario       @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([inicio, fim])
  @@index([imagemId])
  @@index([destinoLojaId])
}

// ───────── Mapas (geocoding e rotas pelo servidor) ─────────

enum OrigemDistancia {
  ROTA // pelas ruas (Routes API ou cache dela)
  ESTIMADA // linha reta × 1,3 (API fora, cota esgotada ou tempo esgotado)
}

/// Chamadas feitas ao Google por dia (limite diário e acompanhamento). Sem dado pessoal.
model UsoMapa {
  dia      DateTime @db.Date // dia civil em America/Sao_Paulo
  servico  String   @db.VarChar(20) // "geocoding" | "rotas"
  chamadas Int      @default(0)

  @@id([dia, servico])
}

/// Distância pelas ruas já calculada: origem e destino arredondados em 4 casas
/// (~11 m), guardados ×10⁴ como inteiros. Validade conferida no service (30 dias).
model CacheRota {
  origemLat       Int
  origemLng       Int
  destinoLat      Int
  destinoLng      Int
  distanciaMetros Int
  criadoEm        DateTime @default(now())

  @@id([origemLat, origemLng, destinoLat, destinoLng])
}

// ───────── Pagamento online (Mercado Pago, Split 1:1) ─────────
// Plano e decisões: docs/pagamento-online.md.

enum ModoEntrega {
  PLATAFORMA // entregador do Taaki
  PROPRIO // motoboy da loja
}

enum OrigemFreteGratis {
  NENHUM
  LOJA // frete grátis configurado pela loja (custo da loja)
  CAMPANHA // primeira compra (custo da plataforma)
}

enum OrigemTaxaEntrega {
  KM // R$ 1,00 + R$ 0,90/km (shared/taxaKm)
  AREA // taxa da área de entrega (reserva do PDV sem pino)
}

enum StatusConexaoMp {
  CONECTADA
  EXPIRADA // a renovação do token falhou: a loja precisa conectar de novo
  DESCONECTADA
}

enum MetodoPagamentoOnline {
  PIX
  CARTAO_ONLINE
}

/// Tipo real do pagamento com cartão pelo app (Etapa 7).
enum TipoPagamentoOnline {
  CREDITO
  DEBITO
  PRE_PAGO
  SALDO_MERCADO_PAGO
  OUTRO // ex.: Linha de Crédito Mercado Pago
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  EXPIRADO
  CANCELADO
  REEMBOLSADO
  REEMBOLSO_PARCIAL
  REEMBOLSO_PENDENTE // estorno recusado pelo Mercado Pago: o ADMIN resolve (sem retentativa)
  A_ESTORNAR // aprovado depois de o pedido expirar: o pedido não revive; estorno automático (Etapa 5)
  CONTESTADO // chargeback ou mediação aberta pelo comprador no Mercado Pago
}

enum SituacaoCampanha {
  RESERVADO // pedido criado, ainda não aprovado nem finalizado
  USADO
}

enum TipoLancamentoLoja {
  TAXA_ENTREGA_DINHEIRO // a loja recebeu o dinheiro e deve a taxa (entregador da plataforma)
  TAXA_ENTREGA_COMPLEMENTO // parte da taxa que não coube no split (trava de 50%)
  CREDITO_CAMPANHA // crédito da loja: taxa da área na campanha em loja PROPRIO
  AJUSTE_MANUAL
  ESTORNO // desfaz um lançamento (lançamento nunca se apaga nem se altera)
}

enum TipoAlerta {
  RENOVACAO_MP_FALHOU // token da loja não renovou: conexão EXPIRADA, pagamento online desligado
  PAGAMENTO_DIVERGENTE // valor, pedido ou comissão do Mercado Pago diferente do nosso: não aprovado
  PAGO_APOS_EXPIRAR // Pix aprovado com o pedido já expirado: pagamento A_ESTORNAR
  MP_DESVINCULADA // a loja desvinculou a conta no Mercado Pago (mp-connect): pagamento online desligado
  TAXA_ENTREGA_COMPLEMENTO // taxa passou de 50% do valor cobrado: o resto fica como débito da loja
  PIX_FALHANDO // mais de 3 falhas ao gerar Pix na mesma loja em 1 hora
  LOJA_SEM_LOCALIZACAO // loja PLATAFORMA sem pino: pedido do app usou a taxa da área
  REEMBOLSO_FALHOU // estorno recusado ou com erro: pagamento REEMBOLSO_PENDENTE (sem retentativa)
  CHARGEBACK // contestação ou mediação no Mercado Pago
  ESTORNO_EXTERNO // estorno feito direto no Mercado Pago com o pedido ainda aberto
  PEDIDO_SEM_ACEITE // pedido pago online há 10 minutos sem o aceite da loja
  FECHAMENTO_ATRASADO // fechamento semanal aguardando pagamento há mais de FECHAMENTO_ATRASO_DIAS
}

enum StatusFechamento {
  ABERTO
  AGUARDANDO_PAGAMENTO
  QUITADO
}

/// Conta Mercado Pago da loja (OAuth). Tokens só cifrados (AES-256-GCM, lib/cifra.js);
/// desconectar apaga os tokens. CHECK: CONECTADA exige o access token. Índice único parcial
/// "ConexaoMercadoPago_conta_em_uso_key" (só na migration): a mesma conta (mpUserId) só pode
/// estar CONECTADA ou EXPIRADA em uma loja; desconectada, pode ir para outra.
model ConexaoMercadoPago {
  id                  Int             @id @default(autoincrement())
  lojaId              Int             @unique
  mpUserId            String          @db.VarChar(30)
  accessTokenCifrado  String?
  refreshTokenCifrado String?
  publicKey           String?         @db.VarChar(100)
  expiraEm            DateTime?
  status              StatusConexaoMp @default(CONECTADA)
  conectadaEm         DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Restrict)
}

/// Uma tentativa de pagamento online do pedido (Pix ou cartão); a loja é a do pedido.
/// CHECKs: total > 0; valor da plataforma no split e reembolsado entre 0 e o total.
model Pagamento {
  id                       Int                   @id @default(autoincrement())
  pedidoId                 Int
  metodo                   MetodoPagamentoOnline
  status                   StatusPagamento       @default(PENDENTE)
  mpPaymentId              String?               @unique @db.VarChar(30)
  mpPreferenceId           String?               @unique @db.VarChar(80)
  valorTotalCentavos       Int
  /// Comissão do marketplace enviada ao Mercado Pago (0 = campo omitido).
  valorPlataformaCentavos  Int                   @default(0)
  valorReembolsadoCentavos Int                   @default(0)
  idempotencyKey           String                @unique @db.VarChar(64)
  expiraEm                 DateTime
  pixQrCode                String?
  pixQrCodeBase64          String?
  /// Cartão: init_point da preferência do Checkout Pro (o app reabre em "Tentar de novo").
  checkoutUrl              String?               @db.VarChar(500)
  /// Campos relevantes da resposta do Mercado Pago (status_detail, datas, ids). Nunca dado de cartão.
  dadosMp                  Json?
  estornos                 Estorno[]
  aprovadoEm               DateTime?
  /// Última consulta ao Mercado Pago (tela do Pix no app: no máximo a cada 30 s).
  consultadoEm             DateTime?
  criadoEm                 DateTime              @default(now())
  atualizadoEm             DateTime              @updatedAt

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@index([status, expiraEm])
}

enum OrigemEstorno {
  AUTOMATICO // recusa da loja, cancelamento do cliente antes do aceite, pago depois de expirar
  ADMIN
  MERCADO_PAGO // feito direto no Mercado Pago (chegou pelo webhook)
}

enum StatusEstorno {
  PROCESSANDO
  CONCLUIDO
  FALHOU // sem retentativa automática: o ADMIN tenta de novo ou resolve por fora
  RESOLVIDO_POR_FORA
}

/// Uma tentativa de estorno (Etapa 5). CHECKs na migration: valor > 0, chave obrigatória fora
/// da origem MERCADO_PAGO, concluidoEm só nos status concluídos.
model Estorno {
  id             Int           @id @default(autoincrement())
  pagamentoId    Int
  valorCentavos  Int
  motivo         String        @db.VarChar(300)
  origem         OrigemEstorno
  status         StatusEstorno @default(PROCESSANDO)
  idempotencyKey String?       @unique @db.VarChar(64)
  mpRefundId     String?       @db.VarChar(30)
  /// Código e detalhe limpo do Mercado Pago (sem token nem dado pessoal).
  erro           String?       @db.VarChar(300)
  observacao     String?       @db.VarChar(500)
  usuarioId      Int?
  resolvidoPorId Int?
  criadoEm       DateTime      @default(now())
  concluidoEm    DateTime?

  pagamento    Pagamento @relation(fields: [pagamentoId], references: [id], onDelete: Restrict)
  usuario      Usuario?  @relation("EstornoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  resolvidoPor Usuario?  @relation("EstornoResolvidoPor", fields: [resolvidoPorId], references: [id], onDelete: Restrict)

  @@index([pagamentoId])
  @@index([status])
  @@index([concluidoEm])
}

/// Notificação recebida do Mercado Pago (dedupe pela chave e auditoria). Sem dado pessoal.
model EventoWebhook {
  id           Int       @id @default(autoincrement())
  chave        String    @unique @db.VarChar(200)
  tipo         String    @db.VarChar(60)
  recursoId    String?   @db.VarChar(60)
  recebidoEm   DateTime  @default(now())
  processadoEm DateTime?
  resultado    String?   @db.VarChar(200)

  @@index([recebidoEm])
}

/// Frete grátis da primeira compra: um por telefone verificado. Reservado na criação do
/// pedido, USADO na aprovação/finalização; expirar ou cancelar apaga a linha (libera).
/// O telefone NÃO é guardado: só o HMAC-SHA256 dele (CAMPANHA_TELEFONE_SECRET), para a regra
/// "um por telefone" sobreviver à exclusão da conta sem manter o número.
/// CHECKs: usadoEm só (e sempre) no USADO; hash com 64 hexadecimais.
model UsoCampanhaFreteGratis {
  id           Int              @id @default(autoincrement())
  telefoneHash String           @unique @db.VarChar(64)
  clienteId    Int?
  pedidoId     Int              @unique
  situacao     SituacaoCampanha @default(RESERVADO)
  reservadoEm  DateTime         @default(now())
  usadoEm      DateTime?

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
}

/// Livro-razão entre a loja e a plataforma. Positivo = a loja deve à plataforma;
/// negativo = a plataforma deve à loja. Só inserção (trigger recusa DELETE e UPDATE,
/// menos o vínculo ao fechamento); correção = lançamento ESTORNO. CHECK: valor != 0.
model LancamentoLoja {
  id            Int                @id @default(autoincrement())
  lojaId        Int
  pedidoId      Int?
  tipo          TipoLancamentoLoja
  valorCentavos Int
  observacao    String?            @db.VarChar(300)
  fechamentoId  Int?
  criadoPorId   Int?
  /// ESTORNO: o lançamento que este desfaz (CHECK: só e sempre no ESTORNO; um por lançamento).
  /// Índice único parcial (só na migration): um lançamento automático de cada tipo por pedido.
  estornaId     Int?               @unique
  criadoEm      DateTime           @default(now())

  loja         Loja               @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  pedido       Pedido?            @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  fechamento   FechamentoSemanal? @relation(fields: [fechamentoId], references: [id], onDelete: Restrict)
  criadoPor    Usuario?           @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  estorna      LancamentoLoja?    @relation("EstornoDeLancamento", fields: [estornaId], references: [id], onDelete: Restrict)
  estornadoPor LancamentoLoja?    @relation("EstornoDeLancamento")

  @@index([lojaId, criadoEm])
  @@index([pedidoId])
  @@index([fechamentoId])
}

/// Fechamento semanal da loja (segunda a domingo pelo dia operacional; `fim` exclusivo).
/// CHECKs: fim > inicio; QUITADO = quitadoEm preenchido.
model FechamentoSemanal {
  id            Int              @id @default(autoincrement())
  lojaId        Int
  inicio        DateTime         @db.Date
  fim           DateTime         @db.Date
  saldoCentavos Int              @default(0)
  status        StatusFechamento @default(ABERTO)
  quitadoEm     DateTime?
  quitadoPorId  Int?
  observacao    String?          @db.VarChar(300)
  criadoEm      DateTime         @default(now())
  atualizadoEm  DateTime         @updatedAt

  loja        Loja               @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  quitadoPor  Usuario?           @relation(fields: [quitadoPorId], references: [id], onDelete: Restrict)
  lancamentos LancamentoLoja[]
  alertas     AlertaPlataforma[]

  @@unique([lojaId, inicio])
}

/// Alerta para o ADMIN (tela "Alertas" da plataforma). Resolvido = resolvidoEm preenchido
/// (CHECK: com quem resolveu). As próximas etapas só acrescentam tipos.
model AlertaPlataforma {
  id             Int        @id @default(autoincrement())
  tipo           TipoAlerta
  lojaId         Int?
  pedidoId       Int?
  mensagem       String     @db.VarChar(500)
  criadoEm       DateTime   @default(now())
  resolvidoEm    DateTime?
  resolvidoPorId Int?
  fechamentoId   Int? // FECHAMENTO_ATRASADO: um por fechamento

  loja         Loja?              @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  pedido       Pedido?            @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  resolvidoPor Usuario?           @relation(fields: [resolvidoPorId], references: [id], onDelete: Restrict)
  fechamento   FechamentoSemanal? @relation(fields: [fechamentoId], references: [id], onDelete: Restrict)

  @@index([resolvidoEm, criadoEm])
  @@index([lojaId])
  @@index([fechamentoId])
}
