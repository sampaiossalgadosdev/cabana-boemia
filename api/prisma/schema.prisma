generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Convenções: dinheiro em centavos (Int), peso em gramas (Int), datas em UTC.
// Saldo de estoque oficial = campo `estoque` (Produto/Insumo), alterado só por
// decremento/incremento atômico. MovimentacaoEstoque é apenas histórico.

// ───────────── Enums ─────────────

enum Papel {
  ADMIN // plataforma (Delivery Abatiá): acima do DONO, sem loja
  DONO
  ATENDENTE
}

enum TipoPreco {
  UNIDADE
  POR_KG
}

enum CanalPedido {
  SITE
  WHATSAPP
  SALAO
}

enum StatusPedido {
  ABERTO
  CONFIRMADO
  EM_PREPARO // delivery/encomenda: só uso interno do PDV (o cliente não vê)
  SAIU_ENTREGA
  FINALIZADO
  CANCELADO
}

enum FormaPagamento {
  PIX
  DINHEIRO
  DEBITO
  CREDITO
}

enum TipoMovimentacao {
  VENDA
  ESTORNO
  ENTRADA
  AJUSTE
}

enum TipoTrabalhoImpressao {
  PEDIDO
  CANCELAMENTO
  CONTA
  FECHAMENTO
  RELATORIO_DIA
}

enum TipoMovimentoCaixa {
  SANGRIA
  SUPRIMENTO
}

enum StatusTrabalhoImpressao {
  PENDENTE
  IMPRESSO
  FALHOU
}

// ───────────── Loja ─────────────

/// Loja da plataforma. A Cabana Boemia é a primeira (slug "cabana-boemia", criada pela
/// migration `multi_loja` a partir da antiga Configuracao). Leva a configuração que era
/// da linha única: nome, WhatsApp, tempo estimado, virada do dia e frete grátis.
/// CHECKs (só na migration): slug, documento (11 ou 14 dígitos), cores #RRGGBB,
/// horaViradaDia 0–12, frete grátis ligado exige mínimo > 0.
model Loja {
  id                        Int       @id @default(autoincrement())
  slug                      String    @unique @db.VarChar(60) // minúsculas, números e hífen
  nome                      String    @db.VarChar(100)
  razaoSocial               String?   @db.VarChar(150)
  documento                 String?   @db.VarChar(14) // CNPJ (14) ou CPF (11), só dígitos
  endereco                  String?   @db.VarChar(200)
  whatsapp                  String    @default("") // só dígitos com o 55 (wa.me); vazio = não configurado
  logoUrl                   String?   @db.VarChar(500)
  corPrimaria               String?   @db.VarChar(7) // "#RRGGBB"
  corFundo                  String?   @db.VarChar(7)
  descricao                 String?   @db.VarChar(500)
  ativa                     Boolean   @default(true)
  ordem                     Int       @default(0)
  tempoEstimadoPadraoMin    Int       @default(40)
  tempoEstimadoManualMin    Int?
  tempoManualDefinidoEm     DateTime?
  horaViradaDia             Int       @default(4) // dia operacional vira às HH:00 local (0–12; CHECK)
  freteGratisAtivo          Boolean   @default(false)
  freteGratisMinimoCentavos Int? // frete grátis a partir deste subtotal (centavos); CHECK: ligado exige > 0
  freteGratisWhatsapp       Boolean   @default(true) // frete grátis vale também no delivery lançado pelo PDV
  criadoEm                  DateTime  @default(now())
  atualizadoEm              DateTime  @updatedAt

  usuarios   Usuario[]
  categorias Categoria[]
  produtos   Produto[]
  insumos    Insumo[]
  turnos     Turno[]
  areas      AreaEntrega[]
  pedidos    Pedido[]
  contadores ContadorPedido[]
  caixas     Caixa[]
  impressoes TrabalhoImpressao[]
}

// ───────────── Acesso ─────────────

/// ADMIN não tem loja; DONO e ATENDENTE têm exatamente uma (CHECK na migration `multi_loja`).
model Usuario {
  id           Int      @id @default(autoincrement())
  lojaId       Int?
  nome         String
  email        String   @unique
  senhaHash    String
  papel        Papel
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  loja Loja? @relation(fields: [lojaId], references: [id], onDelete: Restrict)

  refreshTokens   RefreshToken[]
  pedidosCriados  Pedido[]
  movimentacoes   MovimentacaoEstoque[]
  caixasAbertos   Caixa[]               @relation("CaixaAbertoPor")
  caixasFechados  Caixa[]               @relation("CaixaFechadoPor")
  movimentosCaixa MovimentoCaixa[]

  @@index([lojaId])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  hash       String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// ───────────── Clientes ─────────────

model Cliente {
  id           Int      @id @default(autoincrement())
  googleId     String?  @unique
  appleId      String?  @unique // "sub" do Entrar com Apple (app iOS)
  nome         String
  /// Nome sem acento e minúsculo (busca do PDV: "joao" acha "João"). Calculado
  /// pela extensão em src/lib/prisma.js a cada gravação de `nome`; sem default.
  nomeBusca    String
  email        String?
  telefone     String?
  observacao   String?  @db.VarChar(300) // anotação da equipe (PDV)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  enderecos     Endereco[]
  pedidos       Pedido[]
  refreshTokens RefreshTokenCliente[]

  @@index([telefone])
}

model Endereco {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  rua         String
  numero      String
  complemento String?
  referencia  String?
  bairroId    Int
  cep         String?  @db.VarChar(8) // só dígitos (PDV; o site não usa)
  cidade      String?  @db.VarChar(60)
  estado      String?  @db.VarChar(30)
  principal   Boolean  @default(false) // no máximo um por cliente (garantido no service)
  criadoEm    DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  bairro  Bairro  @relation(fields: [bairroId], references: [id])

  @@index([clienteId])
}

/// Bairro da cidade (lista única, cadastrada pelo ADMIN). O endereço do cliente
/// aponta para ele e vale para qualquer loja; onde cada loja entrega (e por quanto)
/// fica em AreaEntrega. Desativado na cidade = nenhuma loja entrega lá.
model Bairro {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  ativo Boolean @default(true)

  enderecos Endereco[]
  areas     AreaEntrega[]
}

/// Área de entrega da loja: bairros onde ela entrega, com a taxa dela.
/// Sem linha (ou inativa) = a loja não entrega no bairro (BAIRRO_FORA_DA_AREA).
/// CHECK (migration bairros_da_cidade): taxaCentavos >= 0.
model AreaEntrega {
  lojaId       Int
  bairroId     Int
  taxaCentavos Int
  ativo        Boolean @default(true)

  loja   Loja   @relation(fields: [lojaId], references: [id])
  bairro Bairro @relation(fields: [bairroId], references: [id])

  @@id([lojaId, bairroId])
  @@index([bairroId])
}

// ───────────── Cardápio ─────────────

model Categoria {
  id     Int     @id @default(autoincrement())
  lojaId Int
  nome   String
  ordem  Int     @default(0)
  ativo  Boolean @default(true)

  loja     Loja      @relation(fields: [lojaId], references: [id])
  produtos Produto[]

  @@unique([lojaId, nome])
}

/// Turnos, insumos e categoria do produto são da mesma loja (conferido no service).
model Produto {
  id              Int       @id @default(autoincrement())
  lojaId          Int
  nome            String
  descricao       String    @default("")
  categoriaId     Int
  tipoPreco       TipoPreco @default(UNIDADE)
  precoCentavos   Int // UNIDADE: preço da unidade; POR_KG: preço do quilo
  ativo           Boolean   @default(true)
  disponivelHoje  Boolean   @default(false)
  vendidoNoSite   Boolean   @default(true) // false: só aparece no PDV (ex.: Prato por kg)
  sugerirNaSacola Boolean   @default(false) // "Peça também" na sacola do site
  imagemUrl       String?   @db.VarChar(500) // link da foto (site); null = placeholder
  controlaEstoque Boolean   @default(false)
  estoque         Int? // saldo oficial quando controlaEstoque = true
  estoqueMinimo   Int?
  ordem           Int       @default(0)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  loja          Loja                  @relation(fields: [lojaId], references: [id])
  categoria     Categoria             @relation(fields: [categoriaId], references: [id])
  turnos        ProdutoTurno[]
  insumos       ProdutoInsumo[]
  itensPedido   ItemPedido[]
  movimentacoes MovimentacaoEstoque[]

  @@unique([lojaId, nome])
  @@index([categoriaId])
}

/// Horários (HorarioTurno) e produtos (ProdutoTurno) herdam a loja do turno.
model Turno {
  id     Int     @id @default(autoincrement())
  lojaId Int
  nome   String
  ativo  Boolean @default(true)

  loja     Loja           @relation(fields: [lojaId], references: [id])
  horarios HorarioTurno[]
  produtos ProdutoTurno[]

  @@unique([lojaId, nome])
}

model HorarioTurno {
  id        Int    @id @default(autoincrement())
  turnoId   Int
  diaSemana Int // 0 = domingo … 6 = sábado (validado no service)
  inicio    String @db.VarChar(5) // "HH:MM"
  fim       String @db.VarChar(5) // "HH:MM"; "00:00" = meia-noite (fim do dia)

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@index([turnoId, diaSemana])
}

model ProdutoTurno {
  produtoId Int
  turnoId   Int

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  turno   Turno   @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@id([produtoId, turnoId])
  @@index([turnoId])
}

// ───────────── Estoque ─────────────

model Insumo {
  id            Int    @id @default(autoincrement())
  lojaId        Int
  nome          String
  estoque       Int    @default(0) // saldo oficial
  estoqueMinimo Int    @default(0)

  loja          Loja                  @relation(fields: [lojaId], references: [id])
  produtos      ProdutoInsumo[]
  movimentacoes MovimentacaoEstoque[]

  @@unique([lojaId, nome])
}

model ProdutoInsumo {
  produtoId  Int
  insumoId   Int
  quantidade Int // unidades do insumo consumidas por 1 unidade do produto

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumo  Insumo  @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@id([produtoId, insumoId])
  @@index([insumoId])
}

/// Histórico/auditoria apenas. Nunca usado para calcular saldo.
model MovimentacaoEstoque {
  id           Int              @id @default(autoincrement())
  tipo         TipoMovimentacao
  produtoId    Int?
  insumoId     Int?
  quantidade   Int // delta com sinal: VENDA negativo, ESTORNO/ENTRADA positivo, AJUSTE ±
  itemPedidoId Int?
  usuarioId    Int?
  motivo       String?          @db.VarChar(200) // ENTRADA/AJUSTE da retaguarda (obrigatório no AJUSTE)
  criadoEm     DateTime         @default(now())

  produto    Produto?    @relation(fields: [produtoId], references: [id])
  insumo     Insumo?     @relation(fields: [insumoId], references: [id])
  itemPedido ItemPedido? @relation(fields: [itemPedidoId], references: [id])
  usuario    Usuario?    @relation(fields: [usuarioId], references: [id])

  @@index([produtoId])
  @@index([insumoId])
  @@index([itemPedidoId])
}

// ───────────── Pedidos ─────────────

/// Sempre de uma loja só (itens, caixa e impressões são da mesma loja).
model Pedido {
  id                  Int             @id @default(autoincrement())
  lojaId              Int
  numeroDia           Int
  dataRef             DateTime        @db.Date // dia local (America/Sao_Paulo) do pedido
  canal               CanalPedido
  status              StatusPedido    @default(ABERTO)
  clienteId           Int?
  nomeCliente         String
  telefone            String?
  enderecoTexto       String?
  bairroNome          String?
  taxaEntregaCentavos Int             @default(0)
  subtotalCentavos    Int             @default(0)
  totalCentavos       Int             @default(0)
  formaPagamento      FormaPagamento?
  trocoParaCentavos   Int?
  mesaRotulo          String?
  tempoEstimadoMin    Int? // tempo mostrado ao cliente, gravado na criação
  chaveIdempotencia   String?         @unique // reenvio do mesmo pedido devolve o já criado
  criadoPorId         Int?
  criadoEm            DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt
  finalizadoEm        DateTime?
  canceladoEm         DateTime?
  caixaId             Int? // caixa em que foi FINALIZADO (ou pago antes, no "pago agora")
  /// Encomenda: entrega/retirada agendada (mesmo dia operacional). CHECK: encomenda = (agendadoPara não nulo).
  encomenda           Boolean         @default(false)
  agendadoPara        DateTime?
  retirarNoBalcao     Boolean         @default(false) // só encomenda, sem endereço nem taxa (CHECK)
  descontoCentavos    Int             @default(0) // só pedidos da equipe; total = subtotal + taxa − desconto
  observacao          String?         @db.VarChar(200) // observação do pedido inteiro
  pagoEm              DateTime? // "pago agora" no PDV: forma e caixaId gravados na criação

  loja       Loja                @relation(fields: [lojaId], references: [id])
  cliente    Cliente?            @relation(fields: [clienteId], references: [id])
  caixa      Caixa?              @relation(fields: [caixaId], references: [id], onDelete: Restrict)
  criadoPor  Usuario?            @relation(fields: [criadoPorId], references: [id])
  itens      ItemPedido[]
  impressoes TrabalhoImpressao[]

  @@unique([lojaId, dataRef, numeroDia])
  @@index([status])
  @@index([clienteId, criadoEm])
  @@index([criadoEm])
  @@index([caixaId])
}

model ItemPedido {
  id                    Int       @id @default(autoincrement())
  pedidoId              Int
  produtoId             Int
  nomeSnapshot          String
  precoUnitarioCentavos Int // UNIDADE: por unidade; POR_KG: por quilo
  quantidade            Int       @default(1)
  pesoGramas            Int? // só para POR_KG
  totalCentavos         Int
  observacao            String?
  criadoEm              DateTime  @default(now())
  canceladoEm           DateTime?

  pedido        Pedido                @relation(fields: [pedidoId], references: [id])
  produto       Produto               @relation(fields: [produtoId], references: [id])
  movimentacoes MovimentacaoEstoque[]

  @@index([pedidoId])
  @@index([produtoId])
}

/// Último numeroDia emitido em cada dia operacional, por loja. Incrementado por
/// INSERT ... ON CONFLICT DO UPDATE dentro da transação do pedido (sem corrida).
model ContadorPedido {
  lojaId  Int
  dataRef DateTime @db.Date
  ultimo  Int

  loja Loja @relation(fields: [lojaId], references: [id])

  @@id([lojaId, dataRef])
}

// ───────────── Impressão ─────────────

/// Dono: um pedido (PEDIDO, CANCELAMENTO, CONTA), um caixa (FECHAMENTO) ou um dia operacional
/// (RELATORIO_DIA, `dataRelatorio`); exatamente um (CHECK).
model TrabalhoImpressao {
  id            Int                     @id @default(autoincrement())
  lojaId        Int
  pedidoId      Int?
  caixaId       Int?
  dataRelatorio DateTime?               @db.Date // RELATORIO_DIA: dia operacional do resumo
  tipo          TipoTrabalhoImpressao
  status        StatusTrabalhoImpressao @default(PENDENTE)
  tentativas    Int                     @default(0)
  ultimoErro    String?
  criadoEm      DateTime                @default(now())
  impressoEm    DateTime?

  loja   Loja    @relation(fields: [lojaId], references: [id])
  pedido Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  caixa  Caixa?  @relation(fields: [caixaId], references: [id], onDelete: Restrict)

  @@index([lojaId, status, criadoEm])
  @@index([pedidoId])
  @@index([caixaId])
}

// ───────── Caixa ─────────

/// Caixa do balcão (dinheiro de salão, delivery e site). Só um aberto por LOJA:
/// índice único parcial "Caixa_um_aberto" ("lojaId" WHERE "fechadoEm" IS NULL), só nas
/// migrations `caixa`/`multi_loja` (o Prisma não declara índice parcial). Esperado e diferença
/// são calculados e gravados no fechamento (cego para a equipe; só o DONO vê).
model Caixa {
  id                   Int       @id @default(autoincrement())
  lojaId               Int
  abertoPorId          Int
  abertoEm             DateTime  @default(now())
  valorInicialCentavos Int // fundo de troco
  fechadoPorId         Int?
  fechadoEm            DateTime?
  valorContadoCentavos Int?
  esperadoCentavos     Int?
  diferencaCentavos    Int? // contado − esperado
  observacao           String?

  loja       Loja                @relation(fields: [lojaId], references: [id])
  abertoPor  Usuario             @relation("CaixaAbertoPor", fields: [abertoPorId], references: [id])
  fechadoPor Usuario?            @relation("CaixaFechadoPor", fields: [fechadoPorId], references: [id], onDelete: Restrict)
  movimentos MovimentoCaixa[]
  pedidos    Pedido[]
  impressoes TrabalhoImpressao[]

  @@index([lojaId, abertoEm])
}

model MovimentoCaixa {
  id            Int                @id @default(autoincrement())
  caixaId       Int
  tipo          TipoMovimentoCaixa
  valorCentavos Int // > 0 (CHECK); o sinal vem do tipo
  motivo        String
  usuarioId     Int
  criadoEm      DateTime           @default(now())

  caixa   Caixa   @relation(fields: [caixaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([caixaId])
}

// ───────────── Sessão do app do cliente e exclusão de conta ─────────────

/// Refresh token do cliente (app). Opaco, rotativo, ~60 dias; no banco só o HMAC.
/// O site não pede refresh: continua só com o JWT de 7 dias.
model RefreshTokenCliente {
  id         Int       @id @default(autoincrement())
  clienteId  Int
  hash       String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

/// Pedido de exclusão de conta pela página pública /excluir-conta (link do Play Console).
/// Atendido à mão pelo dono (confere a identidade e exclui).
model SolicitacaoExclusao {
  id         Int       @id @default(autoincrement())
  nome       String?   @db.VarChar(100)
  email      String?   @db.VarChar(200)
  telefone   String?   @db.VarChar(20)
  mensagem   String?   @db.VarChar(500)
  criadoEm   DateTime  @default(now())
  atendidaEm DateTime?

  @@index([criadoEm])
}

enum EventoAcesso {
  LOGIN
  REFRESH
  PEDIDO
  EXCLUSAO_CONTA
}

/// Registro de acesso do cliente (Marco Civil da Internet, art. 15): guardado por
/// 6 meses e apagado por rotina diária. `clienteId` SEM chave estrangeira de
/// propósito: o registro precisa sobreviver à exclusão da conta pelo prazo legal.
model RegistroAcesso {
  id        Int          @id @default(autoincrement())
  clienteId Int?
  ip        String       @db.VarChar(45)
  evento    EventoAcesso
  criadoEm  DateTime     @default(now())

  @@index([criadoEm])
  @@index([clienteId])
}
