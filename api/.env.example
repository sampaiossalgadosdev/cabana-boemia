# Conexão com o PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/restaurante?schema=public"

# Banco SÓ para testes (é apagado e recriado a cada arquivo de teste que usa banco).
# O nome precisa conter "test". Sem esta variável, os testes de banco são pulados.
DATABASE_URL_TEST="postgresql://usuario:senha@localhost:5432/restaurante_test?schema=public"

# Segredos dos tokens (mínimo 32 caracteres cada, os três diferentes entre si). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET: access token da equipe. JWT_REFRESH_SECRET: hash dos refresh tokens.
# JWT_CLIENTE_SECRET: token do cliente do site (separado do da equipe).
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_CLIENTE_SECRET=""

# Client ID OAuth do Google (login do cliente no site), ex.: 1234-abc.apps.googleusercontent.com
# É público (vai para o site via GET /publico/config). Sem ele, POST /cliente/auth/google responde 503.
GOOGLE_CLIENT_ID=""

# Outros clientes OAuth aceitos no login com Google (app Android/iOS), separados por vírgula.
# Somam-se ao GOOGLE_CLIENT_ID. Vazio = só o do site.
GOOGLE_CLIENT_IDS=""

# Entrar com Apple (app iOS): bundle id(s) aceitos como audience; vazio = br.com.taaki.app.
APPLE_BUNDLE_IDS=""
# Para revogar o login na Apple ao excluir a conta (exigência da App Store). Sem as três,
# o login com Apple funciona e a conta é excluída, só a Apple não é avisada.
# Team ID (10 caracteres), Key ID da chave "Sign in with Apple" e o conteúdo do .p8
# numa linha só, com \n no lugar das quebras de linha.
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# E-mail do canal do titular (LGPD) nas páginas /privacidade-app e /termos-app.
# Vazio = só o formulário de /excluir-conta. Quem é o controlador: api/src/lib/controlador.js.
CONTATO_TITULAR_EMAIL=""

# Login com celular no app (código de 6 dígitos). Verificador plugável:
#   vazio = desligado (o app mostra "verificação indisponível");
#   "test" = sem SMS: só os números de PHONE_TEST_NUMBERS, cada um com o código fixo.
# PROIBIDO em produção: com NODE_ENV=production (ou no ambiente "production" do
# Railway) e PHONE_VERIFIER=test a API não sobe...
PHONE_VERIFIER=""
# ...a menos que esta seja "sim": liberação explícita para a FASE DE TESTES no Railway.
# Apagar as três (PHONE_VERIFIER, PHONE_TEST_NUMBERS e esta) antes de abrir o app ao público.
PHONE_TEST_EM_PRODUCAO=""
# "+55DDD9XXXXXXXX:código,..." (6 números no código). Use números fictícios, ex.:
# PHONE_TEST_NUMBERS="+5543999990001:123456,+5543999990002:654321"
PHONE_TEST_NUMBERS=""

# Domínios do Taaki Delivery (api/src/lib/dominios.js): neles / é a landing do Taaki,
# /app leva ao app e /parceiro à retaguarda; o site da Cabana não aparece. Nos outros
# hosts (cabana.managerpix.com.br, .up.railway.app, localhost) nada muda.
# Vazio = taakidelivery.com.br,www.taakidelivery.com.br,api.taakidelivery.com.br.
# As origens https:// desses hosts entram no CORS sozinhas (somadas a CORS_ORIGINS).
TAAKI_HOSTS=""
# Destino de /app (só https). Vazio = página do app no Google Play.
TAAKI_APP_URL=""
# Destino de /app no iPhone/iPad (App Store, quando houver). Vazio = o mesmo de TAAKI_APP_URL.
TAAKI_APP_URL_IOS=""
# Landing do Taaki (api/src/lib/landing.js). "sim" = o app está publicado: "Quero pedir"
# e "Pedir agora" levam a /app. Vazio ou outro valor = modo "Em breve": os botões levam à
# seção que explica a fase de testes (lançamento anunciado no Instagram).
TAAKI_APP_LANCADO=""
# Resposta de "O app funciona no iPhone?" na landing. Vazio = "A versão para Android sai
# primeiro. A de iPhone vem em seguida."
TAAKI_FAQ_IPHONE=""
# Perfil do Instagram do Taaki (só https). Vazio = a landing cita o Instagram sem link.
TAAKI_INSTAGRAM_URL=""


# Mapas (pino do endereço e distância pelas ruas; passo a passo em app/CONFIGURACAO_MAPAS.md).
# Chave do SERVIDOR (Google Cloud: só Geocoding API e Routes API; nunca vai ao app).
# Vazia = sem busca de endereço (o cliente posiciona o pino) e distância só estimada.
GOOGLE_MAPS_SERVER_KEY=""
# Chave do Maps JavaScript da retaguarda (restrita aos domínios de /admin). Entregue pela
# API à retaguarda, como o googleClientId. Vazia = a retaguarda pede o pino por latitude/longitude.
GOOGLE_MAPS_WEB_KEY=""
# Limite de chamadas por dia (Brasília). Vazio = 300 (geocoding) e 500 (rotas).
# Bateu o limite: geocoding pede o pino à mão e a distância cai na linha reta × 1,3.
MAPAS_LIMITE_GEOCODING_DIA=""
MAPAS_LIMITE_ROTAS_DIA=""
# Centro da cidade "latitude,longitude" (centro do mapa e do raio de 60 km aceito
# para pinos). Vazio = Abatiá-PR.
MAPAS_CENTRO=""
# Taxa por km (entrega pela plataforma; calculada e testada, AINDA NÃO COBRADA).
# Centavos; vazio = 100 (base) e 90 (por km de ida e volta).
TAXA_KM_BASE_CENTAVOS=""
TAXA_KM_POR_KM_CENTAVOS=""
# "sim" = pedido do app em loja com entregadores do Taaki não precisa do pino no mapa
# (usa a taxa da área). Só para testes enquanto o Google Maps não está configurado.
# Vazio = o pino é obrigatório (PINO_OBRIGATORIO).
PINO_ENTREGA_OPCIONAL=""

# Pagamento online (Mercado Pago, Split 1:1; plano em docs/pagamento-online.md).
# "sim" liga; vazio (ou outro valor) = desligado e tudo como antes.
PAGAMENTO_ONLINE_ATIVO=""
# Chave dos tokens da loja (AES-256-GCM): 64 caracteres hexadecimais. Obrigatória com
# PAGAMENTO_ONLINE_ATIVO=sim (a API não sobe sem ela). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""
# Menor pedido mínimo do frete grátis de uma loja com entregador da plataforma
# (centavos). Vazio = 2000 (R$ 20,00).
FRETE_GRATIS_MINIMO_PLATAFORMA_CENTAVOS=""
# Aplicativo (marketplace) no painel do Mercado Pago: credenciais e a URL de retorno do
# OAuth da loja, cadastrada igual no painel. Produção:
# https://api.taakidelivery.com.br/api/mercadopago/oauth/retorno
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_REDIRECT_URI=""
# Assina o state do OAuth (32+ caracteres, diferente dos JWT). Obrigatório para conectar
# uma loja e, com PAGAMENTO_ONLINE_ATIVO=sim, para a API subir.
MP_STATE_SECRET=""
# HMAC do telefone na campanha de frete grátis da primeira compra (32+ caracteres,
# diferente dos JWT). O telefone em si não é guardado. Vazio = campanha desligada; com
# PAGAMENTO_ONLINE_ATIVO=sim ou CAMPANHA_FRETE_GRATIS_ATIVA=sim a API não sobe sem ele.
CAMPANHA_TELEFONE_SECRET=""
# Liga a campanha de frete grátis da primeira compra ("sim"; vazio = desligada), independente
# do PAGAMENTO_ONLINE_ATIVO. Só funciona com o CAMPANHA_TELEFONE_SECRET válido; ligada sem ele
# a API não sobe. Ligar no dia do lançamento (precisa do SMS real: PHONE_VERIFIER).
CAMPANHA_FRETE_GRATIS_ATIVA=""
# Chave secreta das notificações (painel do Mercado Pago › Suas integrações › Webhooks):
# confere a assinatura x-signature do POST /api/mercadopago/webhook. Com
# PAGAMENTO_ONLINE_ATIVO=sim a API não sobe sem ela.
MP_WEBHOOK_SECRET=""
# Fechamento semanal das lojas (livro-razão): alerta para o ADMIN quando um fechamento
# fica aguardando pagamento há mais destes dias. Vazio = 7.
FECHAMENTO_ATRASO_DIAS=""
# Orçamento da campanha de frete grátis da primeira compra, em centavos (só para o resumo
# do Financeiro; nada é bloqueado). Vazio = 70000 (R$ 700,00).
CAMPANHA_ORCAMENTO_CENTAVOS=""

# Origens permitidas, separadas por vírgula
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Porta HTTP da API
PORT=3000

# Opcionais
# "production" no Railway (log do morgan no formato "combined"); em dev pode ficar sem.
NODE_ENV=""
# Injetada pelo Railway (nome do ambiente, ex.: "production"); não preencher em dev.
RAILWAY_ENVIRONMENT_NAME=""
# Custo do bcrypt (padrão 12, mínimo 4). Só os testes baixam este valor.
BCRYPT_CUSTO=""
