{
  "name": "restaurante",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de pedidos do restaurante Cabana Boemia (Abatiá-PR)",
  "workspaces": [
    "api",
    "pdv",
    "retaguarda",
    "site",
    "shared",
    "app"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "npm run build -w site && npm run build -w retaguarda && node scripts/copiar-builds.mjs && npm run prisma:generate -w api",
    "start": "npm run start:producao -w api",
    "dev:api": "npm run dev -w api",
    "dev:site": "npm run dev -w site",
    "dev:retaguarda": "npm run dev -w retaguarda",
    "dev:pdv": "npm run dev -w pdv",
    "test": "npm test --workspaces --if-present",
    "seed:demo": "npm run seed:demo -w api"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
