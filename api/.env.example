# Conexão com o PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/restaurante?schema=public"

# Banco SÓ para testes (é apagado e recriado a cada arquivo de teste que usa banco).
# O nome precisa conter "test". Sem esta variável, os testes de banco são pulados.
DATABASE_URL_TEST="postgresql://usuario:senha@localhost:5432/restaurante_test?schema=public"

# Segredos dos tokens (mínimo 32 caracteres cada, os três diferentes entre si). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET: access token da equipe. JWT_REFRESH_SECRET: hash dos refresh tokens.
# JWT_CLIENTE_SECRET: token do cliente do site (separado do da equipe).
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_CLIENTE_SECRET=""

# Client ID OAuth do Google (login do cliente no site), ex.: 1234-abc.apps.googleusercontent.com
# É público (vai para o site via GET /publico/config). Sem ele, POST /cliente/auth/google responde 503.
GOOGLE_CLIENT_ID=""

# Outros clientes OAuth aceitos no login com Google (app Android/iOS), separados por vírgula.
# Somam-se ao GOOGLE_CLIENT_ID. Vazio = só o do site.
GOOGLE_CLIENT_IDS=""

# Entrar com Apple (app iOS): bundle id(s) aceitos como audience; vazio = br.com.deliveryabatia.app.
APPLE_BUNDLE_IDS=""
# Para revogar o login na Apple ao excluir a conta (exigência da App Store). Sem as três,
# o login com Apple funciona e a conta é excluída, só a Apple não é avisada.
# Team ID (10 caracteres), Key ID da chave "Sign in with Apple" e o conteúdo do .p8
# numa linha só, com \n no lugar das quebras de linha.
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# E-mail do canal do titular (LGPD) nas páginas /privacidade-app e /termos-app.
# Vazio = só o formulário de /excluir-conta. Quem é o controlador: api/src/lib/controlador.js.
CONTATO_TITULAR_EMAIL=""

# Login com celular no app (código de 6 dígitos). Verificador plugável:
#   vazio = desligado (o app mostra "verificação indisponível");
#   "test" = sem SMS: só os números de PHONE_TEST_NUMBERS, cada um com o código fixo.
# PROIBIDO em produção: com NODE_ENV=production (ou no ambiente "production" do
# Railway) e PHONE_VERIFIER=test a API não sobe.
PHONE_VERIFIER=""
# "+55DDD9XXXXXXXX:código,..." (6 números no código). Use números fictícios, ex.:
# PHONE_TEST_NUMBERS="+5543999990001:123456,+5543999990002:654321"
PHONE_TEST_NUMBERS=""

# Origens permitidas, separadas por vírgula
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Porta HTTP da API
PORT=3000

# Opcionais
# "production" no Railway (log do morgan no formato "combined"); em dev pode ficar sem.
NODE_ENV=""
# Injetada pelo Railway (nome do ambiente, ex.: "production"); não preencher em dev.
RAILWAY_ENVIRONMENT_NAME=""
# Custo do bcrypt (padrão 12, mínimo 4). Só os testes baixam este valor.
BCRYPT_CUSTO=""
